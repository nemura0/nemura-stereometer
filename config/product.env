# NEMURA Stereometer: product identity. The single source of truth for names, IDs and version.
#
# Rules:
#   - One KEY="value" per line, no inline comments (CMake, bash and gen-config.sh all parse this).
#   - Rename the product with scripts/rename.sh; it rewrites this file and regenerates
#     Sources/Core/include/nmr/product_config.h (scripts/gen-config.sh).
#   - Changing an *_ID or AU code makes DAWs treat the plugin as a different plugin.

# Display names
NMR_PRODUCT_NAME="NEMURA Stereometer"
NMR_PRODUCT_SHORT="Stereometer"
NMR_VENDOR="NEMURA"
NMR_COPYRIGHT="Copyright (c) 2026 Vicente Guerra"
NMR_URL="https://github.com/nemura0/nemura-stereometer"
NMR_DESCRIPTION="Goniometer, vectorscope, correlation and balance meter."

# Version (semver) and build number
NMR_VERSION="1.0.0"
NMR_BUILD="1"

# Identifiers
NMR_APP_BUNDLE_ID="dev.vicguerra.stereometer"
NMR_PLUGIN_BUNDLE_ID="dev.vicguerra.stereometer.plugin"
NMR_CLAP_ID="dev.vicguerra.stereometer"
NMR_AU_TYPE="aufx"
NMR_AU_SUBTYPE="Stmt"
NMR_AU_MANUFACTURER="Nmra"

# Runtime names (shm names must stay <= 31 chars including the leading '/')
NMR_SHM_PREFIX="/nmr.stm"
NMR_OBJC_PREFIX="NMRStm"
NMR_SUPPORT_SUBDIR="NEMURA/Stereometer"
NMR_LOG_SUBSYSTEM="dev.vicguerra.stereometer"

# Distribution
NMR_GITHUB_REPO="nemura0/nemura-stereometer"
NMR_HOMEBREW_TAP="nemura0/tap"
NMR_SIGNING_IDENTITY="NEMURA Stereometer Self-Signed"
